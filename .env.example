# Vite (portfolio-saas)

# Backend base URL (portfolio-api). Mismo host que en OAuth callbacks (no mezclar localhost con 127.0.0.1).
VITE_API_URL=http://localhost:9000

# Optional: same value as API_ADMIN_SECRET if you want to call POST /technologies without a user JWT (dev/scripts only).
# Logged-in users send their session JWT instead. Do not ship real secrets to the browser in production.
# VITE_API_ADMIN_SECRET=
